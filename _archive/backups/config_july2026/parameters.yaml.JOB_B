digital_twin:
  fusion_enabled: true
  security_gate_qkd: true
  sync_opv_grid: true
  update_interval_seconds: 60
  urgency_high_threshold: 2.0
  urgency_medium_threshold: 1.0
lca:
  capex_std: 16100.0
  carbon:
    grid_intensity_gco2_kwh: 450.0
  cooperative:
    annual_cleaning_opex_usd: 800.0
    annual_training_opex_usd: 1200.0
    area_m2: 500.0
    capex_subsidy_rate: 0.3
    coop_members: 5
    crop_price_per_kg: 4.5
    discount_rate: 0.12
    yield_kg_per_m2_yr: 8.2
  default_annual_opex: 2000.0
  default_annual_revenue: 30612.0
  default_capex: 161000.0
  panel_cleaning_annual_cost: 800.0
  pv_efficiency: 0.15
  pv_fill_factor: 0.8
  reference_biomass_kg: 12.0
  revenue_std: 3061.0
  scenario_b_biomass_kg: 10.0
  scenario_b_power_factor: 1.1
  scenario_b_water_factor: 0.9
  scenario_b_yield_factor: 0.8
  scenario_c_biomass_kg: 12.0
  scenario_c_power_kwh: 0.0
  scenario_c_water_liters: 0.0
  scenario_c_yield_factor: 0.7
microclimate:
  baseline_water_mm: 5.0
  default_rh_pct: 60.0
  default_temp_c: 25.0
  default_wind_speed_m_s: 0.5
  greenhouse:
    crop_coefficient: 0.85
    shading_factor: 0.35
    soiling_factor: 0.05
output:
  dynamics_h5: data/converged/production_dynamics.h5
  graphics_dir: Graphics
physics:
  npom_optimal_mode_volume_nm3: 1.2
  sensing_sentinel_ratio: 0.01
  soiling_decay_rate_per_day: 0.005
quantum:
  floquet:
    driving_amplitude: 0.05
    driving_frequency: 1.2
  fmo:
    coupling_reaction_center: 0.15
    mode_volume_nm3: 1.4
    sites: 8
  npom:
    enabled: true
  sers:
    optomechanical_coupling: 0.01
  solver:
    hierarchy_depth: 8
    n_traj: 20
    sbd_bundles_per_site: 3
    simulation_duration_fs: 1000.0
    time_step_fs: 0.2
quantum_signal:
  kernel_gamma: 0.5
  kernel_regularization: 0.001
  mps_chi: 16
  mps_sweeps: 5
  noise_sigma_fraction: 0.05
  stress_anomaly_zscore: 2.0
security:
  qkd:
    channel_noise_rate: 0.048
    channel_type: fiber
    key_length_bits: 256
    security_threshold: 0.11
simulation:
  solar_flux_threshold: 450.0
  temperature_k: 295.0
